{
  "name": "@mmbt/game-hok-sample",
  "version": "0.0.0",
  "private": true,
  "description": "Static manual HoK sample adapter for local draft testing.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
