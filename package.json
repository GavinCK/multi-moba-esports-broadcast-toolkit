{
  "name": "multi-moba-esports-broadcast-toolkit",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first, manual-first multi-MOBA esports broadcast toolkit workspace baseline.",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
